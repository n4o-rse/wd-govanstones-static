  "datatype": "wikibase-item",
  "descriptions": {
    "ar": {
      "language": "ar",
      "value": "خاصية تشير إلى أن العنصر له أهمية معينة لأحد مشاريع ويكيميديا. هذه الخاصية لا تضفي الملحوظية على العنصر. لا ينبغي إنشاء العناصر بهذه الخاصية إذا لم تكن ملحوظة بالنسبة لويكي بيانات. انظر أيضًا: P6104 وP972 وP2354"
    },
    "ast": {
      "language": "ast",
      "value": "propiedá pa indicar qu'un elementu forma parte d'un grupu d'elementos de interés particular pal mantenimientu, alministración o desendolcu d'un proyectu de Wikimedia"
    },
    "be-tarask": {
      "language": "be-tarask",
      "value": "уласьцівасьць дзеля пазначэньня, што элемэнт — частка групы элемэнтаў, якія прадстаўляюць асаблівую цікавасьць для падтрымкі, абслугоўваньня ці разьвіцьця"
    },
    "ca": {
      "language": "ca",
      "value": "propietat que indica que l'element forma part d'un grup d'elements d'interès particular per al manteniment o desenvolupament del projecte Wikimedia. Veure també P6104, P972, P2354"
    },
    "cs": {
      "language": "cs",
      "value": "vlastnost signalizující, že objekt je zařazen do pracovního seznamu projektu Wikimedia (portál, WikiProjekt atd.). Viz také P6104, P972 a P2354"
    },
    "dag": {
      "language": "dag",
      "value": "di wuhirila wikimedia nini ni miri cho yɛl’ shɛŋa zaŋ ti wikidata"
    },
    "de": {
      "language": "de",
      "value": "die Eigenschaft signalisiert, dass das Objekt auf einer Arbeitsliste eines Wikimedia-Projektes (WikiProjekt, Redaktion, Portal, etc.) enthalten ist.  Siehe auch P6104, P972, P2354"
    },
    "el": {
      "language": "el",
      "value": "ιδιότητα που δείχνει ότι ένα αντικείμενο παρουσιάζει ιδιαίτερο ενδιαφέρον για ένα έργο ενός εγχειρήματος Wikimedia"
    },
    "en": {
      "language": "en",
      "value": "property to indicate that an item is of particular interest for a Wikimedia project. This property does not add notability. Items should not be created with this property if they are not notable for Wikidata. See also P6104, P972, P2354"
    },
    "en-gb": {
      "language": "en-gb",
      "value": "property to indicate that an item is part of a group of items of particular interest for maintenance, management, or development.  See also P6104, P972, P2354"
    },
    "en-us": {
      "language": "en-us",
      "value": "property to indicate that an item is of particular interest for a Wikimedia project. This property does not add notability. Items should not be created with this property if they are not notable for Wikidata. See also P6104, P972, P2354"
    },
    "es": {
      "language": "es",
      "value": "propiedad que indica que el elemento forma parte de un grupo de elementos de interés particular para el mantenimiento o desarrollo del proyecto Wikimedia. Ver también P6104, P972, P2354"
    },
    "eu": {
      "language": "eu",
      "value": "Wikimedia proiektu edo atari baten parte dela adierazten duen propietatea"
    },
    "fi": {
      "language": "fi",
      "value": "Tällä listalla oleva kohde on osa Wikimedian projektia, jonka tarkoituksena on huoltaa, lisätä tai kehittää sen aihepiiriä. Luettelo ei tee aiheesta merkittävää"
    },
    "fr": {
      "language": "fr",
