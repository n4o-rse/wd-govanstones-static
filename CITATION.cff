    given-names: Florian
    orcid: "https://orcid.org/0000-0002-3246-3531"
    affiliation: "Leibniz-Zentrum für Archäologie (LEIZA)"
license: MIT
version: "0.1.0"
repository-code: "https://github.com/n4o-rse/wd-govanstones-static"
